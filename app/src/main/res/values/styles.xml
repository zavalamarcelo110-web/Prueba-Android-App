<resources>
    <!-- Pantalla -->
    <style name="Pantalla">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/padding_pantalla</item>
        <item name="android:background">@color/fondo</item>
        <item name="android:fitsSystemWindows">true</item>
    </style>

    <!-- Textos -->
    <style name="Titulo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/titulo</item>
        <item name="android:textColor">@color/primario</item>
        <item name="android:layout_marginBottom">@dimen/margen</item>
    </style>

    <style name="Subtitulo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/subtitulo</item>
        <item name="android:textColor">@color/primario</item>
        <item name="android:layout_marginTop">@dimen/padding_pantalla</item>
    </style>

    <style name="Texto">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/texto</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:layout_marginTop">@dimen/margen</item>
    </style>

    <style name="Campo" parent="Texto">
        <item name="android:textColorHint">#888888</item>
    </style>

    <!-- Botones -->
    <style name="Boton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/margen</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/texto</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/bg_boton</item>
        <item name="android:backgroundTint">@color/funcion</item>
    </style>

    <style name="Boton.Explicito">
        <item name="android:backgroundTint">@color/explicito</item>
    </style>

    <style name="Boton.Implicito">
        <item name="android:backgroundTint">@color/implicito</item>
    </style>
</resources>
