<resources>

    <!-- =========================================================
         ESTILOS REUTILIZABLES
         Evitan repetir atributos en los layouts (principio DRY).
         ========================================================= -->

    <!-- ===== Textos ===== -->
    <style name="Texto">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/texto</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Texto.Secundario">
        <item name="android:textSize">@dimen/texto_chico</item>
        <item name="android:textColor">@color/texto_secundario</item>
    </style>

    <style name="Texto.Titulo">
        <item name="android:textSize">@dimen/titulo</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:lineSpacingMultiplier">1.0</item>
    </style>

    <style name="Texto.Titulo.Blanco">
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Texto.Subtitulo">
        <item name="android:textSize">@dimen/subtitulo</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>

    <style name="Texto.Blanco">
        <item name="android:textColor">@color/blanco_suave</item>
    </style>

    <!-- Etiqueta translúcida sobre el encabezado -->
    <style name="Texto.ChipVidrio">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:textSize">@dimen/texto_chico</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:background">@drawable/bg_chip_vidrio</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawableTint">@color/white</item>
    </style>

    <!-- Etiqueta con fuente monoespaciada que muestra el código del intent -->
    <style name="Texto.Codigo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:textSize">@dimen/texto_codigo</item>
        <item name="android:textColor">@color/chip_codigo_texto</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:background">@drawable/bg_chip_codigo</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:layout_marginTop">@dimen/margen_chico</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- ===== Encabezado de sección (ícono + título + descripción) ===== -->
    <style name="Seccion">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginTop">@dimen/margen_grande</item>
        <item name="android:layout_marginBottom">@dimen/margen</item>
    </style>

    <style name="Seccion.Icono" parent="">
        <item name="android:layout_width">@dimen/icono_seccion</item>
        <item name="android:layout_height">@dimen/icono_seccion</item>
        <item name="android:padding">9dp</item>
        <item name="android:layout_marginEnd">@dimen/margen</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/white</item>
    </style>

    <!-- ===== Tarjetas ===== -->
    <style name="Tarjeta" parent="Widget.Material3.CardView.Outlined">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardBackgroundColor">@color/superficie</item>
        <item name="cardCornerRadius">@dimen/radio</item>
        <item name="strokeColor">@color/borde</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- Tile: tarjeta pequeña y presionable dentro de una grilla de 2 columnas -->
    <style name="Tarjeta.Tile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@animator/presion</item>
        <item name="rippleColor">@color/superficie_variante</item>
    </style>

    <style name="Tile.Icono" parent="">
        <item name="android:layout_width">@dimen/icono_tile</item>
        <item name="android:layout_height">@dimen/icono_tile</item>
        <item name="android:padding">12dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/white</item>
    </style>

    <style name="Tile.Titulo" parent="Texto">
        <item name="android:textSize">@dimen/texto</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:layout_marginTop">@dimen/margen</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Tile.Descripcion" parent="Texto.Secundario">
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- ===== Botones ===== -->
    <!-- Botón con degradado: se anula el tinte de Material para usar nuestro fondo -->
    <style name="Boton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/alto_boton</item>
        <item name="android:layout_marginTop">@dimen/margen</item>
        <item name="android:textSize">@dimen/texto</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@animator/presion</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_boton_funcion</item>
        <item name="iconTint">@color/white</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
    </style>

    <style name="Boton.Explicito">
        <item name="android:background">@drawable/bg_boton_explicito</item>
    </style>

    <style name="Boton.Implicito">
        <item name="android:background">@drawable/bg_boton_implicito</item>
    </style>

    <!-- Botón translúcido para fondos oscuros -->
    <style name="Boton.Vidrio">
        <item name="android:background">@drawable/bg_boton_vidrio</item>
    </style>

    <!-- Botón redondo de "volver" sobre los encabezados -->
    <style name="BotonVolver">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/bg_boton_circular_vidrio</item>
        <item name="android:src">@drawable/ic_volver</item>
        <item name="android:contentDescription">@string/btn_volver</item>
        <item name="android:stateListAnimator">@animator/presion</item>
        <item name="tint">@color/white</item>
    </style>

    <!-- ===== Campos de texto ===== -->
    <style name="Campo" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="boxCornerRadiusTopStart">@dimen/radio_chico</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radio_chico</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radio_chico</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radio_chico</item>
        <item name="boxStrokeColor">@color/violeta</item>
        <item name="hintTextColor">@color/violeta</item>
        <item name="startIconTint">@color/violeta</item>
        <item name="endIconMode">clear_text</item>
    </style>

    <style name="Campo.Implicito">
        <item name="boxStrokeColor">@color/cian</item>
        <item name="hintTextColor">@color/cian</item>
        <item name="startIconTint">@color/cian</item>
    </style>

    <!-- ===== Pantallas secundarias: encabezado con degradado ===== -->
    <style name="Encabezado">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:clipToOutline">true</item>
    </style>

    <style name="Encabezado.Contenido">
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/padding_pantalla</item>
        <item name="android:paddingEnd">@dimen/padding_pantalla</item>
        <item name="android:paddingTop">@dimen/margen</item>
        <item name="android:paddingBottom">32dp</item>
    </style>

    <!-- Contenedor de cada pantalla bajo el encabezado -->
    <style name="Contenido">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/padding_pantalla</item>
        <item name="android:paddingEnd">@dimen/padding_pantalla</item>
        <item name="android:paddingBottom">@dimen/margen_grande</item>
        <item name="android:layoutAnimation">@anim/layout_entrada</item>
    </style>
</resources>
