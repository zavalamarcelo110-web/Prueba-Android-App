<?xml version="1.0" encoding="utf-8"?>
<!-- Logo: un núcleo (la app) con una órbita y dos satélites (otras apps / pantallas).
     Representa la idea de los Intents: mensajes que viajan entre componentes. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Escala para ocupar bien la zona segura (66dp) del ícono adaptativo -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1.2"
        android:scaleY="1.2">
        <group
            android:pivotX="54"
            android:pivotY="54"
            android:rotation="-30">
            <!-- Órbita -->
            <path
                android:pathData="M28,54a26,11 0,1 0,52 0a26,11 0,1 0,-52 0"
                android:strokeWidth="3"
                android:strokeColor="#CCFFFFFF" />
            <!-- Satélites -->
            <path
                android:fillColor="@color/amarillo"
                android:pathData="M76,54m-4.5,0a4.5,4.5 0,1 1,9 0a4.5,4.5 0,1 1,-9 0" />
            <path
                android:fillColor="@color/cian"
                android:pathData="M32,54m-3.5,0a3.5,3.5 0,1 1,7 0a3.5,3.5 0,1 1,-7 0" />
        </group>
        <!-- Núcleo -->
        <path
            android:fillColor="@android:color/white"
            android:pathData="M54,54m-11,0a11,11 0,1 1,22 0a11,11 0,1 1,-22 0" />
        <!-- Flecha "enviar" dentro del núcleo -->
        <path
            android:fillColor="@color/violeta"
            android:pathData="M50,48.5l9,5.5l-9,5.5l1.6,-5.5z" />
    </group>
</vector>
