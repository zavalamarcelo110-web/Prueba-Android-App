<?xml version="1.0" encoding="utf-8"?>
<!-- Botón de funciones: degradado + ripple (efecto de onda al tocar) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@color/funcion_fin"
                android:startColor="@color/funcion"
                android:type="linear" />
            <corners android:radius="@dimen/radio" />
        </shape>
    </item>
</ripple>
