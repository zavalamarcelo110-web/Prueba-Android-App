<?xml version="1.0" encoding="utf-8"?>
<!-- Chip translúcido (glassmorphism) para usar sobre degradados -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/vidrio" />
    <stroke
        android:width="1dp"
        android:color="@color/vidrio_borde" />
    <corners android:radius="100dp" />
</shape>
