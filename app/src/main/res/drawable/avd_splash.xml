<?xml version="1.0" encoding="utf-8"?>
<!-- Ícono animado del Splash Screen (API de Android 12+).
     El núcleo aparece con un rebote y la órbita gira una vuelta completa. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group
                android:name="orbita"
                android:pivotX="54"
                android:pivotY="54"
                android:rotation="-30">
                <path
                    android:pathData="M28,54a26,11 0,1 0,52 0a26,11 0,1 0,-52 0"
                    android:strokeWidth="3"
                    android:strokeColor="#CCFFFFFF" />
                <path
                    android:fillColor="@color/amarillo"
                    android:pathData="M76,54m-4.5,0a4.5,4.5 0,1 1,9 0a4.5,4.5 0,1 1,-9 0" />
                <path
                    android:fillColor="@color/cian"
                    android:pathData="M32,54m-3.5,0a3.5,3.5 0,1 1,7 0a3.5,3.5 0,1 1,-7 0" />
            </group>
            <group
                android:name="nucleo"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0"
                android:scaleY="0">
                <path
                    android:fillColor="@android:color/white"
                    android:pathData="M54,54m-11,0a11,11 0,1 1,22 0a11,11 0,1 1,-22 0" />
                <path
                    android:fillColor="@color/violeta"
                    android:pathData="M50,48.5l9,5.5l-9,5.5l1.6,-5.5z" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="orbita">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="900"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="rotation"
                android:valueFrom="-210"
                android:valueTo="-30"
                android:valueType="floatType" />
        </aapt:attr>
    </target>

    <target android:name="nucleo">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="600"
                    android:interpolator="@android:anim/overshoot_interpolator"
                    android:propertyName="scaleX"
                    android:startOffset="150"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="600"
                    android:interpolator="@android:anim/overshoot_interpolator"
                    android:propertyName="scaleY"
                    android:startOffset="150"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
