<?xml version="1.0" encoding="utf-8"?>
<!--
    CONFIGURACIÓN (destino de un intent explícito): tema, permisos e información de la app.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fillViewport="true"
    tools:context=".Config">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ================= ENCABEZADO ================= -->
        <FrameLayout
            style="@style/Encabezado"
            android:background="@drawable/bg_header_funcion">

            <com.devstbryan.appproximaprueba.widget.AuroraView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:radioInferior="@dimen/radio_header" />

            <LinearLayout
                android:id="@+id/headerContenido"
                style="@style/Encabezado.Contenido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/btnAtras"
                    style="@style/BotonVolver" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margen_grande"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Texto.Titulo.Blanco"
                            android:accessibilityHeading="true"
                            android:text="@string/titulo_config" />

                        <TextView
                            style="@style/Texto.Blanco"
                            android:layout_marginTop="4dp"
                            android:text="@string/subtitulo_config"
                            android:textSize="@dimen/texto_chico" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ivIconoHeader"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_marginStart="@dimen/margen"
                        android:background="@drawable/bg_chip_vidrio"
                        android:importantForAccessibility="no"
                        android:padding="18dp"
                        android:src="@drawable/ic_ajustes"
                        app:tint="@color/white" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- ================= CONTENIDO ================= -->
        <LinearLayout
            android:id="@+id/contenido"
            style="@style/Contenido"
            android:paddingTop="@dimen/margen_grande">

            <!-- Apariencia: tema claro / oscuro guardado con SharedPreferences -->
            <com.google.android.material.card.MaterialCardView style="@style/Tarjeta">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Texto.Subtitulo"
                        android:accessibilityHeading="true"
                        android:drawablePadding="10dp"
                        android:gravity="center_vertical"
                        android:text="@string/config_apariencia"
                        android:textSize="18sp"
                        app:drawableStartCompat="@drawable/ic_modo_oscuro"
                        app:drawableTint="@color/violeta" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/grupoTema"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margen"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <Button
                            android:id="@+id/btnTemaSistema"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/tema_sistema"
                            android:textAllCaps="false"
                            app:icon="@drawable/ic_modo_sistema"
                            app:iconGravity="top" />

                        <Button
                            android:id="@+id/btnTemaClaro"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/tema_claro"
                            android:textAllCaps="false"
                            app:icon="@drawable/ic_modo_claro"
                            app:iconGravity="top" />

                        <Button
                            android:id="@+id/btnTemaOscuro"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/tema_oscuro"
                            android:textAllCaps="false"
                            app:icon="@drawable/ic_modo_oscuro"
                            app:iconGravity="top" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Estado de los permisos peligrosos (runtime permissions) -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Tarjeta"
                android:layout_marginTop="@dimen/margen">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Texto.Subtitulo"
                        android:accessibilityHeading="true"
                        android:drawablePadding="10dp"
                        android:gravity="center_vertical"
                        android:text="@string/config_permisos"
                        android:textSize="18sp"
                        app:drawableStartCompat="@drawable/ic_escudo"
                        app:drawableTint="@color/esmeralda" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margen"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Texto"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:drawablePadding="10dp"
                            android:gravity="center_vertical"
                            android:text="@string/permiso_camara"
                            android:textSize="14sp"
                            app:drawableStartCompat="@drawable/ic_linterna_on"
                            app:drawableTint="@color/naranja" />

                        <TextView
                            android:id="@+id/tvPermisoCamara"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_vidrio"
                            android:fontFamily="@font/poppins_semibold"
                            android:paddingStart="12dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="4dp"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            tools:text="@string/permiso_concedido" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margen"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Texto"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:drawablePadding="10dp"
                            android:gravity="center_vertical"
                            android:text="@string/permiso_ubicacion"
                            android:textSize="14sp"
                            app:drawableStartCompat="@drawable/ic_ubicacion"
                            app:drawableTint="@color/rosa" />

                        <TextView
                            android:id="@+id/tvPermisoUbicacion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_vidrio"
                            android:fontFamily="@font/poppins_semibold"
                            android:paddingStart="12dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="4dp"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            tools:text="@string/permiso_concedido" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnAjustesApp"
                        style="@style/Boton.Implicito"
                        android:layout_marginTop="@dimen/margen"
                        android:text="@string/btn_ajustes_app"
                        app:icon="@drawable/ic_ajustes" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Información de la app -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Tarjeta"
                android:layout_marginTop="@dimen/margen">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Texto.Subtitulo"
                        android:accessibilityHeading="true"
                        android:drawablePadding="10dp"
                        android:gravity="center_vertical"
                        android:text="@string/config_info"
                        android:textSize="18sp"
                        app:drawableStartCompat="@drawable/ic_info"
                        app:drawableTint="@color/cian" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Texto.Secundario"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/info_version" />

                        <TextView
                            android:id="@+id/tvVersion"
                            style="@style/Texto"
                            android:layout_width="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Texto.Secundario"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/info_api_min" />

                        <TextView
                            android:text="@string/info_api_min_valor"
                            style="@style/Texto"
                            android:layout_width="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Texto.Secundario"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/info_lenguaje" />

                        <TextView
                            android:text="@string/info_lenguaje_valor"
                            style="@style/Texto"
                            android:layout_width="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Texto.Secundario"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/info_paquete" />

                        <TextView
                            android:id="@+id/tvPaquete"
                            style="@style/Texto"
                            android:layout_width="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button
                android:id="@+id/btnVolver"
                style="@style/Boton.Explicito"
                android:layout_marginTop="@dimen/margen_grande"
                android:text="@string/btn_volver"
                app:icon="@drawable/ic_volver" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
