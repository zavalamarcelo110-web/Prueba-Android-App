<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Intents y Funciones"
        android:textStyle="bold"
        android:textSize="38sp"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="15dp"/>

    <!--Linterna-->

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnLinterna"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Encender Linterna 🔦"
        android:textStyle="bold"
        android:textColor="#fffaff"
        android:background="@color/black"/>

    <!-- Intent Explicito  -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSegundaVentana"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🪟 Segunda Ventana"
        android:textStyle="bold"
        android:textColor="#fffaff"
        android:background="@color/black"
        android:layout_marginTop="15dp"/>

    <!--Ubicacion-->

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnUbicacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📍Obtener mi Ubicación"
        android:textStyle="bold"
        android:textColor="#fffaff"
        android:background="@color/black"
        android:layout_marginTop="15dp"/>


    <!--Resultado de la Geolocalización-->
    <TextView
        android:id="@+id/tvUbicacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ubicacion aun no encontrada"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textAlignment="center"
        android:padding="15dp"
        android:layout_marginTop="15dp"/>



    <!-- Intent implicito-->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnMap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🗺️ Ver ubicacion en el Mapa"
        android:textStyle="bold"
        android:textColor="#fffaff"
        android:background="@color/black"/>





  </LinearLayout>