<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <LinearLayout style="@style/Pantalla" android:layout_height="wrap_content">

        <TextView style="@style/Titulo" android:text="@string/titulo" />

        <!-- Intents Explícitos -->
        <TextView style="@style/Subtitulo" android:text="@string/seccion_explicitos" />
        <EditText android:id="@+id/etNombre" style="@style/Campo"
            android:hint="@string/hint_nombre" android:inputType="textPersonName" />
        <Button android:id="@+id/btnSegundaVentana" style="@style/Boton.Explicito" android:text="@string/btn_segunda" />
        <Button android:id="@+id/btnAyuda" style="@style/Boton.Explicito" android:text="@string/btn_ayuda" />
        <Button android:id="@+id/btnConfig" style="@style/Boton.Explicito" android:text="@string/btn_config" />

        <!-- Funciones -->
        <TextView style="@style/Subtitulo" android:text="@string/seccion_funciones" />
        <Button android:id="@+id/btnLinterna" style="@style/Boton" android:text="@string/btn_linterna" />
        <Button android:id="@+id/btnUbicacion" style="@style/Boton" android:text="@string/btn_ubicacion" />
        <TextView android:id="@+id/tvUbicacion" style="@style/Texto"
            android:textAlignment="center" android:text="@string/ubicacion_vacia" />

        <!-- Intents Implícitos -->
        <TextView style="@style/Subtitulo" android:text="@string/seccion_implicitos" />
        <Button android:id="@+id/btnMap" style="@style/Boton.Implicito" android:text="@string/btn_mapa" />
        <Button android:id="@+id/btnWeb" style="@style/Boton.Implicito" android:text="@string/btn_web" />
        <EditText android:id="@+id/etTelefono" style="@style/Campo"
            android:hint="@string/hint_telefono" android:inputType="phone" android:maxLength="9" />
        <Button android:id="@+id/btnLlamar" style="@style/Boton.Implicito" android:text="@string/btn_llamar" />
        <Button android:id="@+id/btnCorreo" style="@style/Boton.Implicito" android:text="@string/btn_correo" />
        <Button android:id="@+id/btnWifi" style="@style/Boton.Implicito" android:text="@string/btn_wifi" />

    </LinearLayout>
</ScrollView>
